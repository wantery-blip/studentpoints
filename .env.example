# 從 Firebase Console > 專案設定 > 你的應用程式 > SDK 設定與配置 > 設定 取得
VITE_FIREBASE_API_KEY=請填入_apiKey
VITE_FIREBASE_AUTH_DOMAIN=請填入_authDomain
VITE_FIREBASE_PROJECT_ID=請填入_projectId
VITE_FIREBASE_APP_ID=請填入_Firebase_Web_App_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# 不是 Firebase 的 appId，而是舊程式 __app_id 對應的資料路徑。
# 新系統可用 default-app-id，舊系統要用原本值。
VITE_DATA_NAMESPACE=default-app-id
