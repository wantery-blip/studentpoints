rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 所有資料均保存在原本的 artifacts/<namespace>/public/data 路徑。
    match /artifacts/{namespace}/public/data {
      function signedIn() { return request.auth != null; }
      function emailUser() {
        return signedIn() && request.auth.token.email is string &&
          request.auth.token.firebase.sign_in_provider == 'password';
      }
      function teacherPath() {
        return /databases/$(database)/documents/artifacts/$(namespace)/public/data/teachers/$(request.auth.uid);
      }
      function requestPath(uid) {
        return /databases/$(database)/documents/artifacts/$(namespace)/public/data/teacher_requests/$(uid);
      }
      function isTeacher() { return signedIn() && exists(teacherPath()); }
      function teacherId() { return get(teacherPath()).data.teacherId; }
      function isOwner(ownerId) { return isTeacher() && teacherId() == ownerId; }
      function isPrimaryEmail() { return emailUser() && request.auth.token.email == 'wantery@gmail.com'; }
      function isPrimaryAdmin() { return isPrimaryEmail() && exists(teacherPath()); }
      function classPath(classId) {
        return /databases/$(database)/documents/artifacts/$(namespace)/public/data/classes/$(classId);
      }
      function codePath(code) {
        return /databases/$(database)/documents/artifacts/$(namespace)/public/data/class_codes/$(code);
      }
      function grantPath(classId) {
        return /databases/$(database)/documents/artifacts/$(namespace)/public/data/class_access/$(request.auth.uid + '_' + classId);
      }
      function validCode(code) {
        return code is string && code.matches('^[A-Z0-9_-]{4,32}$');
      }
      function ownsClass(classId) {
        return signedIn() && exists(classPath(classId)) &&
          // 新帳號的班級 teacherId 即 Firebase Auth UID；直接比對可讓寫入和
          // where(classId == ...) 查詢由 Rules 明確驗證。舊 teacherId 仍走 isOwner。
          (get(classPath(classId)).data.teacherId == request.auth.uid ||
            isOwner(get(classPath(classId)).data.teacherId));
      }
      function studentCanRead(classId) {
        return signedIn() &&
          exists(grantPath(classId)) &&
          get(grantPath(classId)).data.uid == request.auth.uid &&
          get(grantPath(classId)).data.classId == classId &&
          get(grantPath(classId)).data.code == get(classPath(classId)).data.classCode;
      }
      function canReadClass(classId) {
        return ownsClass(classId) || studentCanRead(classId);
      }

      // 教師權限僅能由主要管理者核准，或由主要管理者首次建立自己的帳號。
      // 舊帳號對應舊 teacherId 只可透過 Console / Admin SDK 遷移。
      match /teachers/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create: if (
          (isPrimaryEmail() && request.auth.uid == uid) ||
          (isPrimaryAdmin() && exists(requestPath(uid)) &&
            get(requestPath(uid)).data.uid == uid &&
            get(requestPath(uid)).data.email == request.resource.data.email &&
            get(requestPath(uid)).data.status == 'pending')
        ) &&
          request.resource.data.keys().hasOnly(['teacherId','email','backupUrl','createdAt']) &&
          request.resource.data.keys().hasAll(['teacherId','email','backupUrl','createdAt']) &&
          request.resource.data.teacherId == uid &&
          request.resource.data.email is string &&
          request.resource.data.backupUrl is string &&
          request.resource.data.createdAt == request.time;
        allow update: if signedIn() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','backupUrl','updatedAt']) &&
          request.resource.data.teacherId == resource.data.teacherId;
        allow delete: if false;
      }

      // 一般帳號只能建立自己的「待審核」申請，無法自行取得教師權限。
      // 主要管理者可列出申請，並在核准／駁回時留下審核紀錄。
      match /teacher_requests/{uid} {
        allow create: if emailUser() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['uid','email','name','organization','status','createdAt']) &&
          request.resource.data.keys().hasAll(['uid','email','name','organization','status','createdAt']) &&
          request.resource.data.uid == uid &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 &&
          request.resource.data.organization is string && request.resource.data.organization.size() > 0 && request.resource.data.organization.size() <= 120 &&
          request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
        allow get: if (signedIn() && request.auth.uid == uid) || isPrimaryAdmin();
        allow list: if isPrimaryAdmin();
        allow update: if isPrimaryAdmin() && resource.data.status == 'pending' &&
          request.resource.data.keys().hasOnly(['uid','email','name','organization','status','createdAt','reviewedAt','reviewedBy']) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.organization == resource.data.organization &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected') &&
          request.resource.data.reviewedAt == request.time && request.resource.data.reviewedBy == request.auth.uid;
        allow delete: if false;
      }

      // 舊版明文密碼：完全禁止網頁存取；伺服器 Admin SDK 才能遷移／刪除。
      match /teacher_auth/{legacyId} { allow read, write: if false; }

      // 班級：教師只能管理自己的班級。學生必須先持有正確代碼建立的授權。
      match /classes/{classId} {
        allow get: if isOwner(resource.data.teacherId) || studentCanRead(classId);
        // 新系統的 teacherId 為 Firebase Auth UID，讓清單查詢能以 where(teacherId == UID)
        // 被 Rules 靜態驗證；保留 isOwner 分支以相容已遷移的舊 teacherId。
        allow list: if (signedIn() && resource.data.teacherId == request.auth.uid) ||
          isOwner(resource.data.teacherId);
        allow create: if isOwner(request.resource.data.teacherId) &&
          validCode(request.resource.data.classCode) &&
          request.resource.data.keys().hasAll(['teacherId','name','classCode','totalGroups','createdAt']) &&
          request.resource.data.name is string &&
          request.resource.data.totalGroups is int &&
          request.resource.data.totalGroups >= 1 && request.resource.data.totalGroups <= 20 &&
          (!request.resource.data.keys().hasAny(['groupPointDivisor']) ||
            (request.resource.data.groupPointDivisor is number && request.resource.data.groupPointDivisor > 0 && request.resource.data.groupPointDivisor <= 100)) &&
          (!request.resource.data.keys().hasAny(['includeGroupPointsInIndividualTotal']) || request.resource.data.includeGroupPointsInIndividualTotal is bool) &&
          (!request.resource.data.keys().hasAny(['growthThresholds']) ||
            (request.resource.data.growthThresholds is list && request.resource.data.growthThresholds.size() == 4)) &&
          getAfter(codePath(request.resource.data.classCode)).data.classId == classId;
        allow update: if isOwner(resource.data.teacherId) &&
          request.resource.data.teacherId == resource.data.teacherId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','classCode','totalGroups','groupPointDivisor','includeGroupPointsInIndividualTotal','growthThresholds']) &&
          request.resource.data.name is string &&
          validCode(request.resource.data.classCode) &&
          request.resource.data.totalGroups >= 1 && request.resource.data.totalGroups <= 20 &&
          (!request.resource.data.keys().hasAny(['groupPointDivisor']) ||
            (request.resource.data.groupPointDivisor is number && request.resource.data.groupPointDivisor > 0 && request.resource.data.groupPointDivisor <= 100)) &&
          (!request.resource.data.keys().hasAny(['includeGroupPointsInIndividualTotal']) || request.resource.data.includeGroupPointsInIndividualTotal is bool) &&
          (!request.resource.data.keys().hasAny(['growthThresholds']) ||
            (request.resource.data.growthThresholds is list && request.resource.data.growthThresholds.size() == 4)) &&
          getAfter(codePath(request.resource.data.classCode)).data.classId == classId;
        allow delete: if isOwner(resource.data.teacherId);
      }

      // 代碼索引：只允許按完整代碼 get，不允許列出所有班級代碼。
      match /class_codes/{code} {
        allow get: if signedIn();
        allow list: if false;
        allow create: if isOwner(request.resource.data.teacherId) &&
          validCode(code) &&
          request.resource.data.keys().hasOnly(['classId','teacherId','createdAt']) &&
          getAfter(classPath(request.resource.data.classId)).data.teacherId == teacherId() &&
          getAfter(classPath(request.resource.data.classId)).data.classCode == code;
        allow update: if false;
        allow delete: if isOwner(resource.data.teacherId) &&
          (!existsAfter(classPath(resource.data.classId)) ||
            (getAfter(classPath(resource.data.classId)).data.teacherId == teacherId() &&
              getAfter(classPath(resource.data.classId)).data.classCode != code));
      }

      // 授權單：學生只可替自己登記，Firestore Rules 會自行核對代碼與班級。
      match /class_access/{grantId} {
        function validGrant() {
          return signedIn() &&
            request.auth.token.firebase.sign_in_provider == 'anonymous' &&
            request.resource.data.keys().hasOnly(['uid','classId','code','createdAt']) &&
            request.resource.data.keys().hasAll(['uid','classId','code','createdAt']) &&
            request.resource.data.uid == request.auth.uid &&
            grantId == request.auth.uid + '_' + request.resource.data.classId &&
            validCode(request.resource.data.code) &&
            get(classPath(request.resource.data.classId)).data.classCode == request.resource.data.code &&
            get(codePath(request.resource.data.code)).data.classId == request.resource.data.classId;
        }
        allow create: if validGrant() && request.resource.data.createdAt == request.time;
        allow update: if validGrant() &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.classId == resource.data.classId &&
          request.resource.data.createdAt == request.time;
        allow get: if signedIn() && resource.data.uid == request.auth.uid;
        allow list: if false;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // 學生積分：學生有正確班級授權才可讀，所有修改由班級所屬教師操作。
      match /student_points/{studentId} {
        allow get, list: if canReadClass(resource.data.classId);
        allow create: if ownsClass(request.resource.data.classId) &&
          request.resource.data.keys().hasAll(['name','studentNumber','points','classId']) &&
          request.resource.data.name is string &&
          request.resource.data.studentNumber is string &&
          request.resource.data.points is number &&
          request.resource.data.keys().hasOnly([
            'name','studentNumber','gender','points','classId','groupId','createdAt','lastReason','lastUpdate'
          ]) && request.resource.data.gender in ['male', 'female', ''];
        allow update: if ownsClass(resource.data.classId) &&
          request.resource.data.classId == resource.data.classId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','studentNumber','gender','points','groupId','lastReason','lastUpdate'
          ]) && request.resource.data.points is number &&
          // Existing students can remain without this field until their next edit.
          (!request.resource.data.keys().hasAny(['gender']) ||
            request.resource.data.gender in ['male', 'female', '']);
        allow delete: if ownsClass(resource.data.classId);
      }

      // 加扣分歷程：只允許所屬教師建立及讀取，學生帳號不可查看或變更行為紀錄。
      match /point_history/{historyId} {
        allow get, list: if ownsClass(resource.data.classId);
        allow create: if ownsClass(request.resource.data.classId) &&
          isOwner(request.resource.data.teacherId) &&
          request.resource.data.keys().hasOnly([
            'classId','studentId','teacherId','change','reason','groupId','type','eventId','createdAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'classId','studentId','teacherId','change','reason','type','eventId','createdAt'
          ]) &&
          request.resource.data.studentId is string &&
          request.resource.data.teacherId is string &&
          request.resource.data.change is number &&
          request.resource.data.reason is string &&
          request.resource.data.type is string &&
          request.resource.data.eventId is string &&
          (!request.resource.data.keys().hasAny(['groupId']) || request.resource.data.groupId is int ||
            request.resource.data.groupId == null) &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if ownsClass(resource.data.classId);
      }

      // 小組分數獨立保存；班級設定可決定是否將「小組分數 ÷ N」併入個人總積分。
      match /group_points/{groupPointId} {
        allow get, list: if canReadClass(resource.data.classId);
        allow create: if ownsClass(request.resource.data.classId) &&
          request.resource.data.keys().hasOnly(['classId','groupId','points','updatedAt']) &&
          request.resource.data.classId is string && request.resource.data.groupId is int &&
          request.resource.data.points is number;
        allow update: if ownsClass(resource.data.classId) &&
          request.resource.data.classId == resource.data.classId &&
          request.resource.data.groupId == resource.data.groupId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','updatedAt']) &&
          request.resource.data.points is number;
        allow delete: if ownsClass(resource.data.classId);
      }

      // 個人化加扣分選單：原版 classId 欄位用來儲存教師 ID。
      match /reward_presets/{presetId} {
        allow get, list: if isOwner(resource.data.classId);
        allow create: if isOwner(request.resource.data.classId) &&
          request.resource.data.keys().hasAll(['label','value','classId']) &&
          request.resource.data.label is string && request.resource.data.value is int &&
          (!request.resource.data.keys().hasAny(['isRedemption']) || request.resource.data.isRedemption is bool);
        allow update: if isOwner(resource.data.classId) &&
          request.resource.data.classId == resource.data.classId &&
          request.resource.data.label is string && request.resource.data.value is int &&
          (!request.resource.data.keys().hasAny(['isRedemption']) || request.resource.data.isRedemption is bool);
        allow delete: if isOwner(resource.data.classId);
      }

      // 班級獎勵卡：教師管理卡片內容、權重與內建圖案；持有正確班級代碼的學生僅可讀取。
      match /reward_cards/{classId} {
        allow get: if canReadClass(classId);
        allow list: if false;
        allow create, update: if ownsClass(classId) &&
          request.resource.data.classId == classId &&
          request.resource.data.cards is list && request.resource.data.cards.size() > 0 &&
          request.resource.data.cards.size() <= 40;
        allow delete: if ownsClass(classId);
      }

      // GitHub 內建獎卡圖片清單：只有主要管理者可登錄上傳至 repo 的檔名；
      // 教師端只讀取清單，並在自己的班級抽獎卡中選用。
      match /card_image_library/{libraryId} {
        allow get: if isTeacher();
        allow list: if false;
        allow create, update: if isPrimaryAdmin() && libraryId == 'github' &&
          request.resource.data.keys().hasOnly(['images','updatedAt']) &&
          request.resource.data.images is list && request.resource.data.images.size() <= 100;
        allow delete: if isPrimaryAdmin() && libraryId == 'github';
      }
    }
    // 預設拒絕所有其他路徑；如果同個 Firebase 專案另有其他系統，勿直接覆蓋其現有規則。
    match /{document=**} { allow read, write: if false; }
  }
}
