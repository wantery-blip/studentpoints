{
  "name": "class-points-secure",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node scripts/check-tsx.cjs && node scripts/check-security.mjs",
    "check:pages": "node scripts/check-pages-build.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project class-points-rules-test \"node --test tests/firestore.rules.test.mjs\"",
    "migrate:legacy": "node scripts/migrate-legacy.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^14.16.0",
    "@firebase/rules-unit-testing": "^5.0.0"
  }
}
